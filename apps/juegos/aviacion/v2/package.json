{
  "name": "hub-nocturno-v2",
  "private": true,
  "type": "module",
  "description": "Hub Nocturno v2: capa de presentación 3D, primer contacto y etapa 1 «decidir sabiendo». El modelo del juego vive en ../js y no se toca.",
  "scripts": {
    "construir": "node herramientas/construir.mjs",
    "vigilar": "node herramientas/construir.mjs --vigilar",
    "servir": "npx http-server -p 8812 -s -c-1 dist",
    "capturas": "node herramientas/capturas.cjs",
    "medir": "node herramientas/medir.cjs",
    "pruebas": "node --test pruebas/*.test.mjs",
    "ejemplo-oficina": "node herramientas/ejemplo-oficina.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "animejs": "4.5.0",
    "camera-controls": "3.1.2",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
