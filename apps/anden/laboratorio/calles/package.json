{
  "name": "anden-laboratorio-calles",
  "private": true,
  "version": "0.0.1",
  "description": "Laboratorio Andén: mapas, ruteo en calle y live tracking simulado (MapLibre + deck.gl + fast_paths WASM). No es producto.",
  "type": "module",
  "scripts": {
    "build": "node herramientas/build.mjs",
    "servir": "node herramientas/servidor.mjs 8765",
    "captura": "node herramientas/captura.mjs",
    "ruteo": "node --max-old-space-size=8192 herramientas/ruteo_escala.mjs"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "9.4.0",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@deck.gl/mesh-layers": "9.4.0",
    "@protomaps/basemaps": "5.7.2",
    "contraction-hierarchy-js": "2.0.0",
    "maplibre-gl": "6.13.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "overrides": {
    "tslib": "2.8.1"
  }
}
